# ==============================================================
# NOVARA E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================
# This repository separates backend and frontend environment configurations.
# 
# 1. For Backend: Copy this template to 'backend/.env'
#    cd backend && cp .env.example .env
#
# 2. For Frontend: Copy this template to 'frontend/.env' (optional for custom API host)
#    cd frontend && cp .env.example .env
# ==============================================================

# --------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# --------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Option A: MongoDB Atlas Cloud Cluster (Recommended)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/novara?retryWrites=true&w=majority
# Option B: Local MongoDB Community Server
MONGODB_URI=mongodb://127.0.0.1:27017/novara

# JSON Web Token Secret (Minimum 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=30d

# Initial House Director (Admin) Provisioning Credentials
ADMIN_EMAIL=admin@novara.luxury
ADMIN_PASSWORD=YourStrongAdminPasswordHere!

# --------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# --------------------------------------------------------------
# Base URL for backend REST API endpoints
VITE_API_URL=http://localhost:5000/api

