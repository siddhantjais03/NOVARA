# ==============================================================
# NOVARA Root .gitignore
# Excludes dependencies, build artifacts, environments & secrets
# ==============================================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Sensitive Credentials (NEVER COMMIT!)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# SSL & Security Keys
*.pem
*.key
*.cert
*.crt

# Production Build Outputs
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
backend/dist/
backend/build/

# Cache & Temporary Directories
.cache/
.parcel-cache/
.temp/
temp/
tmp/
.vite/
frontend/.vite/

# Diagnostic & Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage Outputs
coverage/
.nyc_output/

# Operating System & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# Scratch & Temporary Testing Scripts
scratch/
.system_generated/

backend/scripts/resetDatabaseDangerous.js
